*.pem
*.key
.codex/
.agents/

# OS and editor caches / 운영체제·편집기 캐시
.DS_Store
._*
.godot
.godot-*/
__pycache__/
*.pyc
node_modules/
.next/
.venv/

# Generated builds and local QA captures / 빌드와 로컬 검증 촬영
