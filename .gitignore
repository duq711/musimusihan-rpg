/godot-game/build/
/godot-game/builds/
/UE_Agent_Test/Binaries/
/UE_Agent_Test/DerivedDataCache/
/UE_Agent_Test/Intermediate/
/UE_Agent_Test/Saved/

# Blender automatic backups / Blender 자동 백업
*.blend1
*.blend2

# Export credentials / 내보내기 인증 정보
export_credentials.cfg

