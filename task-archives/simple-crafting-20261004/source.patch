+using System.Collections.Generic;
+using Newtonsoft.Json.Linq;
+
+namespace MusimusihanRpg.Gameplay
+{
+    public sealed partial class WorkshopController
+    {
+        // Apply current copy to the live catalog; preserve historical exports and saved items.
+        void ApplySimpleCraftingDescriptions()
+        {
+            var items=(JObject)Catalog.Inventory["ITEM_DEFINITIONS"];
+            var copy=new Dictionary<string,string>
+            {
+                ["forged_longsword"]="피해 31~57 · 제작대에서 재료로 제작",
+                ["forged_arming_sword"]="피해 29~52 · 기력 -10% · 제작대에서 제작",
+                ["iron_ingot"]="무기·방어구 제작 재료",
+                ["forge_charcoal"]="무기·횃불 제작 재료",
+                ["grip_leather"]="무기·방어구·도구 제작 재료",
+                ["steel_fitting"]="무기·방어구·도구 제작 부속",
+                ["alchemy_water"]="물약 제작에 쓰는 맑은 물",
+                ["alchemy_spirits"]="물약 제작에 쓰는 증류주",
+                ["alchemy_empty_bottle"]="물약 1병을 제작할 때 1개 사용"
+            };
+            foreach(string id in new[]{"alchemy_redroot","alchemy_dawnleaf","alchemy_moonwort","alchemy_bittermint","alchemy_ironbloom"})copy[id]="물약 제작 재료 · 제조법의 필요 수량 확인";
+            foreach(var entry in copy)if(items[entry.Key] is JObject item)item["summary"]=entry.Value;
+        }
+    }
+}
