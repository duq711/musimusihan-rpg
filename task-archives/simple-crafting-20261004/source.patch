diff --git a/unity-game/Assets/RPG/Gameplay/NativeSimpleCraftingSmoke.cs b/unity-game/Assets/RPG/Gameplay/NativeSimpleCraftingSmoke.cs
new file mode 100644
index 0000000000000000000000000000000000000000..78b64b55dce7c5df1c7ea1d32388298a4ca0f58d
--- /dev/null
+++ b/unity-game/Assets/RPG/Gameplay/NativeSimpleCraftingSmoke.cs
@@ -0,0 +1,327 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using UnityEngine;
+using UnityEngine.EventSystems;
+using UnityEngine.Rendering;
+using UnityEngine.UI;
+
+namespace MusimusihanRpg.Gameplay
+{
+    /// <summary>Opt-in packaged-player checks for the actual recipe UI and isolated crafting queue.</summary>
+    public sealed class NativeSimpleCraftingSmoke : MonoBehaviour
+    {
+        static string temporarySettings, previousSettings;
+        static bool Requested => Application.isBatchMode && Environment.GetCommandLineArgs().Contains("-simpleCraftingSmoke");
+        readonly List<string> checks = new List<string>(), errors = new List<string>(), captures = new List<string>();
+        WorkshopController game;
+        NativeGameFlow flow;
+        ExpeditionInventory original;
+        SimpleCraftingSystem originalCrafting;
+        JObject originalQueue, originalBag, originalSession;
+        IEnumerator replay;
+        double started;
+        int frames;
+        bool finished;
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+        static void Prepare()
+        {
+            if (!Requested) return;
+            previousSettings = Environment.GetEnvironmentVariable("RPG_NATIVE_SETTINGS_PATH");
+            temporarySettings = Path.Combine(Application.temporaryCachePath, "simple-crafting-settings-" + Guid.NewGuid().ToString("N") + ".json");
+            Environment.SetEnvironmentVariable("RPG_NATIVE_SETTINGS_PATH", temporarySettings);
+            Application.runInBackground = true;
+            AudioListener.pause = true;
+        }
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.AfterSceneLoad)]
+        static void Launch()
+        {
+            if (Requested) new GameObject("NativeSimpleCraftingSmoke").AddComponent<NativeSimpleCraftingSmoke>();
+        }
+
+        void Awake()
+        {
+            DontDestroyOnLoad(gameObject);
+            started = Time.realtimeSinceStartupAsDouble;
+            AudioListener.pause = true;
+            Application.logMessageReceived += Record;
+        }
+        void OnDestroy() => Application.logMessageReceived -= Record;
+        void Record(string message, string stack, LogType kind)
+        {
+            if (kind == LogType.Error || kind == LogType.Exception || kind == LogType.Assert) errors.Add(message + "\n" + stack);
+        }
+        void Check(bool accepted, string description)
+        {
+            if (!accepted) throw new InvalidOperationException(description);
+            checks.Add(description);
+            Debug.Log("SIMPLE_CRAFTING_CHECK " + checks.Count + " " + description);
+        }
+        static JObject Bag(ExpeditionInventory bag) => new JObject
+        {
+            ["slots"] = JArray.FromObject(bag.Slots), ["equipment"] = JObject.FromObject(bag.Equipment),
+            ["instances"] = JObject.FromObject(bag.EquipmentData)
+        };
+        JObject Session() => new JObject
+        {
+            ["crowns"] = game.Session.Crowns, ["survival"] = game.Session.SurvivalSnapshot(),
+            ["stock"] = game.Session.MerchantStock.DeepClone(), ["spells"] = new JArray(game.Session.LearnedSpells),
+            ["selected_spell"] = game.Session.SelectedSpell
+        };
+        RectTransform Node(string name)
+        {
+            var node = flow.Crafting.Find(name);
+            Check(node != null && node.gameObject.activeInHierarchy, "Visible production crafting control / " + name);
+            return node;
+        }
+        void Click(string name)
+        {
+            var node = Node(name);
+            var button = node.GetComponent<Button>();
+            Check(button != null && button.IsInteractable(), "Enabled production crafting button / " + name);
+            flow.Ui.LayoutWindow(Math.Max(1, Screen.width), Math.Max(1, Screen.height));
+            Canvas.ForceUpdateCanvases();
+            var data = new PointerEventData(EventSystem.current)
+            {
+                button = PointerEventData.InputButton.Left, clickCount = 1,
+                position = RectTransformUtility.WorldToScreenPoint(flow.Ui.Camera, node.TransformPoint(node.rect.center))
+            };
+            var hits = new List<RaycastResult>();
+            EventSystem.current.RaycastAll(data, hits);
+            Check(hits.Count > 0 && hits[0].gameObject == node.gameObject,
+                "Actual EventSystem raycast reaches " + name + " / first=" + (hits.Count == 0 ? "none" : hits[0].gameObject.name));
+            data.pointerCurrentRaycast = data.pointerPressRaycast = hits[0];
+            ExecuteEvents.Execute(node.gameObject, data, ExecuteEvents.pointerDownHandler);
+            ExecuteEvents.Execute(node.gameObject, data, ExecuteEvents.pointerUpHandler);
+            ExecuteEvents.Execute(node.gameObject, data, ExecuteEvents.pointerClickHandler);
+        }
+        void Advance(double seconds)
+        {
+            game.Advance(seconds);
+            flow.Tick(0);
+            flow.Crafting.Refresh();
+        }
+        void Update()
+        {
+            if (finished) return;
+            Input.ResetInputAxes();
+            try
+            {
+                if (Time.realtimeSinceStartupAsDouble - started > 180) throw new TimeoutException("Simple crafting packaged acceptance timed out");
+                game = FindFirstObjectByType<WorkshopController>();
+                if (game?.Session == null || game.Crafting == null || game.NativeGame?.Crafting == null ||
+                    game.NativeGame.Settings?.Store == null || game.DungeonPlayer == null || NativeLoadingScreen.Visible) return;
+                flow = game.NativeGame;
+                game.ManualClock = true;
+                game.DungeonPlayer.ManualClock = true;
+                game.DungeonPlayer.ReleasePointer();
+                if (++frames < 4) return;
+                frames = 0;
+                replay ??= Replay();
+                if (!replay.MoveNext()) Finish();
+            }
+            catch (Exception error) { errors.Add(error.ToString()); Finish(); }
+        }
+
+        IEnumerator Replay()
+        {
+            Check(flow.Settings.Store.Path == temporarySettings, "QA settings are isolated from user preferences");
+            Check(flow.Smithing == null && flow.Alchemy == null &&
+                !flow.Ui.Nodes.Keys.Any(key => key.StartsWith("smithing/") || key.StartsWith("alchemy/")),
+                "Legacy manual forge and alchemy screens are absent from the active native interface");
+            original = game.Session.Inventory;
+            original.AddItem("rusted_sword", 1, false, JObject.Parse("{uid:'simple-crafting-owned-sword',item_tag:'보존할 검',smithing:{quality:81,grip:'balanced_grip',runes:['ember_rune']}}"));
+            original.AddItem("iron_ingot", 3, false); original.AddItem("forge_charcoal", 2, false); original.AddItem("grip_leather", 1, false);
+            originalCrafting = game.Crafting;
+            Check((bool)originalCrafting.Enqueue("forged_longsword")["accepted"], "Original expedition has a real pending recipe before F2");
+            originalQueue = originalCrafting.Snapshot(); originalBag = Bag(original); originalSession = Session();
+            game.OpenTrials();
+            Check(!ReferenceEquals(original, game.Session.Inventory) && !ReferenceEquals(originalCrafting, game.Crafting),
+                "F2 isolates both the original inventory and pending crafting service");
+            Check(game.Trials.RunnableEntries.Count(e => (string)e["id"] == "simple_crafting") == 1 &&
+                !game.Trials.RunnableEntries.Any(e => (string)e["action"] == "smithing" || (string)e["action"] == "alchemy" || (string)e["action"] == "alchemy_recipe" || (string)e["action"] == "distilling"),
+                "F2 exposes one simple crafting route and retires manual crafting routes");
+            Check(game.RunTrial("simple_crafting") && flow.State == "crafting" && flow.Crafting.IsOpen,
+                "Actual simple crafting F2 entry opens the production recipe interface");
+            yield return null;
+
+            var bag = game.Session.Inventory;
+            var crafting = game.Crafting;
+            Click("Category_weapon");
+            yield return null;
+            Click("Recipe_0");
+            Check(flow.Crafting.SelectedRecipe == "forged_longsword", "Real recipe grid selects the forged longsword");
+            Click("QuantityPlus");
+            Check(flow.Crafting.Quantity == 2 && Node("Quantity").GetComponent<Text>().text == "2", "Real quantity button selects two crafts");
+            var recipe = crafting.Recipe(flow.Crafting.SelectedRecipe);
+            foreach (var cost in ((JObject)recipe["materials"]).Properties())
+                Check(Node("MaterialCount_" + cost.Name).GetComponent<Text>().text.Contains(((int)cost.Value * 2).ToString()),
+                    "Production materials table displays selected-quantity requirement / " + cost.Name);
