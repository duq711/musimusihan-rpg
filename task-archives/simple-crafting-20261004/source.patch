@@ -0,0 +1,171 @@
+using System;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+
+namespace MusimusihanRpg.Tests
+{
+    public class SimpleCraftingTests
+    {
+        static SimpleCraftingSystem Fixture(out ExpeditionInventory bag)
+        {
+            var catalog = SourceCatalogs.Load(); bag = new ExpeditionInventory(catalog);
+            return new SimpleCraftingSystem(catalog, bag);
+        }
+        static void Supply(SimpleCraftingSystem system, string recipeId, int quantity = 1, JObject instance = null)
+        {
+            foreach (var cost in ((JObject)system.Recipe(recipeId)["materials"]).Properties())
+                Assert.That(system.Inventory.AddItem(cost.Name, (int)cost.Value * quantity, false, instance), Is.Zero);
+        }
+        static string Enqueue(SimpleCraftingSystem system, string recipeId, int quantity = 1)
+        {
+            var result = system.Enqueue(recipeId, quantity); Assert.That((bool)result["accepted"], Is.True, result.ToString());
+            return (string)result["job_id"];
+        }
+
+        [Test]
+        public void EveryRecipeProducesCatalogItemsWithFixedStatsAndNoManualQuality()
+        {
+            var listing = Fixture(out var unused).Recipes;
+            Assert.That(listing.Count, Is.EqualTo(18));
+            CollectionAssert.AreEquivalent(new[] { "weapon", "armor", "consumable", "other" }, listing.Select(r => (string)r["category"]).Distinct());
+            foreach (var recipe in listing.OfType<JObject>())
+            {
+                var system = Fixture(out var bag); string id = (string)recipe["id"];
+                JObject originalDefinition = (JObject)bag.Definition(id).DeepClone();
+                Supply(system, id, 2); Enqueue(system, id, 2);
+                Assert.That(system.MaximumCraftable(id), Is.Zero, id);
+                system.Tick((double)recipe["seconds"] * 2);
+                Assert.That(system.Queue.Count, Is.Zero, id);
+                Assert.That(bag.CountItem(id), Is.EqualTo((int)recipe["output_quantity"] * 2), id);
+                Assert.That(bag.Slots.All(s => s["instance"] == null), Is.True, id);
+                Assert.That(JToken.DeepEquals(originalDefinition, bag.Definition(id)), Is.True, id);
+            }
+        }
+
+        [Test]
+        public void QuantityUsesTotalCostsAndOnlyFirstQueueJobAdvances()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger", 3);
+            var rows = system.MaterialRows("iron_dagger", 2);
+            Assert.That(rows.All(row => (int)row["required"] == 2 && (int)row["owned"] == 3 && (bool)row["enough"]), Is.True);
+            Assert.That(system.MaximumCraftable("iron_dagger"), Is.EqualTo(3));
+            Enqueue(system, "iron_dagger", 2); Enqueue(system, "iron_dagger");
+            Assert.That(bag.CountItem("iron_ingot"), Is.Zero);
+            Assert.That((double)system.Queue[0]["duration"], Is.EqualTo(16));
+            system.Tick(8);
+            Assert.That(bag.CountItem("iron_dagger"), Is.Zero);
+            Assert.That((double)system.Queue[0]["remaining"], Is.EqualTo(8));
+            Assert.That((double)system.Queue[1]["remaining"], Is.EqualTo(8));
+            system.Tick(12);
+            Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(2));
+            Assert.That(system.Queue.Count, Is.EqualTo(1));
+            Assert.That((double)system.Queue[0]["remaining"], Is.EqualTo(4));
+            system.Tick(4);
+            Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(3)); Assert.That(system.Queue.Count, Is.Zero);
+        }
+
+        [Test]
+        public void RejectedInputsNeverReserveMaterialsOrChangeJobs()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger");
+            var before = JArray.FromObject(bag.Slots);
+            foreach (int quantity in new[] { int.MinValue, -1, 0, 100, int.MaxValue })
+                Assert.That((bool)system.Enqueue("iron_dagger", quantity)["accepted"], Is.False);
+            Assert.That((bool)system.Enqueue(null)["accepted"], Is.False);
+            Assert.That((bool)system.Enqueue("missing")["accepted"], Is.False);
+            Assert.That((bool)system.Enqueue("forged_longsword")["accepted"], Is.False);
+            Assert.That(system.MaterialRows("iron_dagger", int.MaxValue).Count, Is.Zero);
+            Assert.That(system.MaximumCraftable(null), Is.Zero);
+            Assert.That(JToken.DeepEquals(before, JArray.FromObject(bag.Slots)), Is.True); Assert.That(system.Queue.Count, Is.Zero);
+            Enqueue(system, "iron_dagger"); var queued = system.Snapshot();
+            foreach (double delta in new[] { -1, double.NaN, double.NegativeInfinity, double.PositiveInfinity }) system.Tick(delta);
+            Assert.That(JToken.DeepEquals(queued, system.Snapshot()), Is.True);
+            Assert.That((bool)system.Cancel("missing")["accepted"], Is.False);
+        }
+
+        [Test]
+        public void QueueLimitCannotReserveNinthJobMaterials()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger", 9);
+            for (int i = 0; i < SimpleCraftingSystem.MaximumQueueLength; i++) Enqueue(system, "iron_dagger");
+            var before = JArray.FromObject(bag.Slots);
+            Assert.That((string)system.Enqueue("iron_dagger")["reason"], Is.EqualTo("queue_full"));
+            Assert.That(JToken.DeepEquals(before, JArray.FromObject(bag.Slots)), Is.True);
+        }
+
+        [Test]
+        public void CancelRefundsExactReservedInstanceDataAndPreservesExistingWeapon()
+        {
+            var system = Fixture(out var bag);
+            var ingredientTag = new JObject { ["item_tag"] = "남겨둔 재료", ["source"] = "chest" };
+            var swordData = new JObject { ["item_tag"] = "기존 검", ["smithing"] = new JObject { ["quality"] = 88, ["runes"] = new JArray("ember_rune") } };
+            bag.AddItem("forged_longsword", 1, false, swordData); Supply(system, "iron_dagger", 2, ingredientTag);
+            var before = JArray.FromObject(bag.Slots);
+            string job = Enqueue(system, "iron_dagger", 2); system.Tick(7);
+            Assert.That((bool)system.Cancel(job)["accepted"], Is.True); Assert.That(system.Queue.Count, Is.Zero);
+            foreach (var original in before.OfType<JObject>())
+                Assert.That(bag.Slots.Any(s => JToken.DeepEquals(s, original)), Is.True, original.ToString());
+            Assert.That(bag.CountItem("iron_dagger"), Is.Zero);
+            Assert.That((bool)system.Cancel(job)["accepted"], Is.False);
+        }
+
+        [Test]
+        public void FullBagRetainsCompletedOutputAndSubscriberReentryCannotDuplicateIt()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger"); Enqueue(system, "iron_dagger");
+            bag.AddItem("rusted_sword", ExpeditionInventory.MaxSlots, false);
+            system.Tick(8);
+            Assert.That((string)system.Queue[0]["state"], Is.EqualTo("waiting_output"));
+            Assert.That((double)system.Queue[0]["remaining"], Is.Zero); Assert.That(bag.CountItem("iron_dagger"), Is.Zero);
+            system.Tick(100); Assert.That(system.Queue.Count, Is.EqualTo(1));
+            bag.RemoveItem("rusted_sword", 1, false); bool reentered = false;
+            bag.Changed += () => { reentered = true; system.Tick(100); Assert.That((string)system.Enqueue("iron_dagger")["reason"], Is.EqualTo("busy")); };
+            system.Tick(0);
+            Assert.That(reentered, Is.True); Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(1)); Assert.That(system.Queue.Count, Is.Zero);
+            system.Tick(100); Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(1));
+        }
+
+        [Test]
+        public void FullBagCancelRetainsAllRefundsUntilWholeRefundFits()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger"); string job = Enqueue(system, "iron_dagger");
+            bag.AddItem("rusted_sword", ExpeditionInventory.MaxSlots, false);
+            Assert.That((bool)system.Cancel(job)["refund_pending"], Is.True);
+            Assert.That((string)system.Queue[0]["state"], Is.EqualTo("refund_pending"));
+            bag.RemoveItem("rusted_sword", 1, false); var before = JArray.FromObject(bag.Slots); system.Tick(100);
+            Assert.That(JToken.DeepEquals(before, JArray.FromObject(bag.Slots)), Is.True, "refund may not partially fill the bag");
+            Assert.That(system.Queue.Count, Is.EqualTo(1));
+            bag.RemoveItem("rusted_sword", 1, false); system.Tick(0);
+            Assert.That(system.Queue.Count, Is.Zero); Assert.That(bag.CountItem("iron_ingot"), Is.EqualTo(1));
+            Assert.That(bag.CountItem("grip_leather"), Is.EqualTo(1)); Assert.That(bag.CountItem("iron_dagger"), Is.Zero);
+        }
+
+        [Test]
+        public void SnapshotRecipeAndQueueCopiesAreIsolatedAndRestoreKeepsBagObject()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger"); Enqueue(system, "iron_dagger"); system.Tick(3);
+            var snapshot = system.Snapshot(); var mutableQueue = system.Queue; var mutableRecipe = system.Recipe("iron_dagger"); var mutableRecipes = system.Recipes;
+            mutableQueue[0]["remaining"] = 0; mutableQueue[0]["reserved"][0]["quantity"] = 999;
+            mutableRecipe["materials"]["iron_ingot"] = 0; mutableRecipes[0]["name"] = "changed";
+            Assert.That((double)system.Queue[0]["remaining"], Is.EqualTo(5)); Assert.That((int)system.Recipe("iron_dagger")["materials"]["iron_ingot"], Is.EqualTo(1));
+            var restored = new SimpleCraftingSystem(SourceCatalogs.Load(), bag);
+            Assert.That(restored.Restore(snapshot), Is.True); snapshot["queue"][0]["remaining"] = 0;
+            Assert.That(restored.Inventory, Is.SameAs(bag)); Assert.That((double)restored.Queue[0]["remaining"], Is.EqualTo(5));
+            restored.Tick(5); Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(1));
+        }
+
+        [Test]
+        public void InvalidRestoreIsAtomicAndCannotRewriteRecipeOutput()
+        {
+            var system = Fixture(out var bag); Supply(system, "iron_dagger"); Enqueue(system, "iron_dagger");
+            var original = system.Snapshot(); var invalid = (JObject)original.DeepClone(); invalid["queue"][0]["reserved"][0]["quantity"] = int.MaxValue;
+            Assert.That(system.Restore(invalid), Is.False); Assert.That(JToken.DeepEquals(original, system.Snapshot()), Is.True);
+            invalid = (JObject)original.DeepClone(); invalid["queue"][0]["remaining"] = double.NaN;
+            Assert.That(system.Restore(invalid), Is.False); Assert.That(JToken.DeepEquals(original, system.Snapshot()), Is.True);
+            var changed = (JObject)original.DeepClone(); changed["queue"][0]["output_id"] = "reliquary"; changed["queue"][0]["output_quantity"] = 999;
+            Assert.That(system.Restore(changed), Is.True); system.Tick(8);
+            Assert.That(bag.CountItem("iron_dagger"), Is.EqualTo(1)); Assert.That(bag.CountItem("reliquary"), Is.Zero);
+        }
+    }
+}
