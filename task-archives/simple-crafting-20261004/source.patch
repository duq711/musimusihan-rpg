+                Check(File.Exists(path) && new FileInfo(path).Length > 1000, "Saved the actual recipe/materials/quantity/queue interface at 1280x720");
+            }
+            finally
+            {
+                RenderTexture.active = active;
+                if (pixels != null) Destroy(pixels);
+                target.Release(); Destroy(target);
+                for(int i=0;i<scalers.Length;i++){scalers[i].enabled=scalerEnabled[i];scalers[i].GetComponent<Canvas>().scaleFactor=canvasScales[i];}
+                ui.LayoutWindow(Math.Max(1,Screen.width),Math.Max(1,Screen.height));Canvas.ForceUpdateCanvases();
+            }
+        }
+        void Finish()
+        {
+            if (finished) return;
+            finished = true;
+            try
+            {
+                if (game?.Trials?.Active == true) game.EndTrials();
+                game?.DungeonPlayer?.ReleasePointer();
+            }
+            catch (Exception error) { errors.Add("Cleanup: " + error); }
+            Environment.SetEnvironmentVariable("RPG_NATIVE_SETTINGS_PATH", previousSettings);
+            try
+            {
+                if (temporarySettings != null && File.Exists(temporarySettings)) File.Delete(temporarySettings);
+                if (temporarySettings != null && File.Exists(temporarySettings + ".tmp")) File.Delete(temporarySettings + ".tmp");
+            }
+            catch (Exception error) { errors.Add("Settings cleanup: " + error); }
+            var report = new JObject
+            {
+                ["result"] = errors.Count == 0 ? "Passed" : "Failed", ["checks"] = new JArray(checks), ["errors"] = new JArray(errors),
+                ["captures"] = new JArray(captures), ["gpu"] = SystemInfo.graphicsDeviceType.ToString(),
+                ["seconds"] = Time.realtimeSinceStartupAsDouble - started, ["hardware_input_verified"] = false, ["speaker_output_verified"] = false,
+                ["scope"] = "Packaged native recipe UI with real EventSystem clicks, quantities/material payment, FIFO completion/cancel, pause/menu clocks, retired station routes, blocked output and exact original F2 inventory/queue restoration. Optional Metal capture is offscreen; hardware input, audible output and whole-game certification are separate."
+            };
+            string path = Path.GetFullPath(Output);
+            Directory.CreateDirectory(Path.GetDirectoryName(path)); File.WriteAllText(path, report.ToString());
+            Debug.Log("SIMPLE_CRAFTING_ACCEPTANCE " + report["result"] + " checks=" + checks.Count);
+            Application.Quit(errors.Count == 0 ? 0 : 1);
+        }
+    }
+}
