diff --git a/unity-game/Assets/RPG/Gameplay/NativeCrafting.cs b/unity-game/Assets/RPG/Gameplay/NativeCrafting.cs
new file mode 100644
index 0000000000000000000000000000000000000000..fe6476856c2a95c2c4e9a5bfa0c3462cbe823cc7
