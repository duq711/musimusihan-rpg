@@ -0,0 +1,237 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+
+namespace MusimusihanRpg
+{
+    /// <summary>Fixed recipes, reserved ingredients and a single timed crafting queue.</summary>
+    public sealed class SimpleCraftingSystem
+    {
+        public const int MaximumQuantity = 99;
+        public const int MaximumQueueLength = 8;
+        public const int MaxQueue = MaximumQueueLength;
+        readonly SourceCatalogs catalog;
+        readonly Dictionary<string, JObject> recipes = new Dictionary<string, JObject>();
+        readonly List<JObject> jobs = new List<JObject>();
+        long nextJobId = 1;
+        bool busy;
+        public ExpeditionInventory Inventory { get; }
+        public event Action Changed;
+        public JArray Recipes => new JArray(recipes.Values.Select(Clone));
+        public JArray Queue => new JArray(jobs.Select(Clone));
+        static JObject Clone(JObject value) => (JObject)value.DeepClone();
+        static bool Finite(double value) => !double.IsNaN(value) && !double.IsInfinity(value);
+        static JObject Result(bool accepted, string reason = "") => new JObject { ["accepted"] = accepted, ["reason"] = reason };
+
+        public SimpleCraftingSystem(SourceCatalogs catalog, ExpeditionInventory inventory)
+        {
+            this.catalog = catalog ?? throw new ArgumentNullException(nameof(catalog));
+            Inventory = inventory ?? throw new ArgumentNullException(nameof(inventory));
+            AddRecipe("forged_longsword", "weapon", 15, 1, "철과 가죽으로 장검을 만듭니다.", "iron_ingot", 3, "forge_charcoal", 2, "grip_leather", 1);
+            AddRecipe("forged_arming_sword", "weapon", 12, 1, "가볍게 다룰 수 있는 한손검을 만듭니다.", "iron_ingot", 2, "forge_charcoal", 1, "grip_leather", 1);
+            AddRecipe("iron_dagger", "weapon", 8, 1, "철제 단검을 만듭니다.", "iron_ingot", 1, "grip_leather", 1);
+            AddRecipe("hunting_bow", "weapon", 12, 1, "사냥꾼의 활을 조립합니다.", "grip_leather", 2, "steel_fitting", 1);
+            AddRecipe("chain_flail", "weapon", 15, 1, "사슬과 철구를 갖춘 철퇴를 만듭니다.", "iron_ingot", 3, "steel_fitting", 2, "forge_charcoal", 1);
+            AddRecipe("wanderer_hood", "armor", 8, 1, "원정용 두건을 만듭니다.", "grip_leather", 2);
+            AddRecipe("patched_mail", "armor", 16, 1, "철과 가죽으로 쇄자갑을 만듭니다.", "iron_ingot", 3, "grip_leather", 2, "steel_fitting", 2);
+            AddRecipe("round_shield", "armor", 12, 1, "철테를 두른 원형 방패를 만듭니다.", "iron_ingot", 2, "grip_leather", 2, "steel_fitting", 1);
+            AddRecipe("healing_draught", "consumable", 5, 1, "핏뿌리로 회복약 한 병을 만듭니다.", "alchemy_water", 1, "alchemy_redroot", 2, "alchemy_empty_bottle", 1);
+            AddRecipe("antidote", "consumable", 5, 1, "쓴박하로 해독약 한 병을 만듭니다.", "alchemy_water", 1, "alchemy_bittermint", 2, "alchemy_empty_bottle", 1);
+            AddRecipe("nerve_tonic", "consumable", 5, 1, "새벽잎과 쓴박하로 각성 약액을 만듭니다.", "alchemy_water", 1, "alchemy_dawnleaf", 1, "alchemy_bittermint", 1, "alchemy_empty_bottle", 1);
+            AddRecipe("alchemy_red_mending_normal", "consumable", 6, 1, "정해진 재료로 표준 봉합약 한 병을 만듭니다.", "alchemy_water", 1, "alchemy_redroot", 2, "alchemy_ironbloom", 1, "alchemy_empty_bottle", 1);
+            AddRecipe("alchemy_moon_distillate_normal", "consumable", 6, 1, "달쑥으로 표준 지혈 정수 한 병을 만듭니다.", "alchemy_spirits", 1, "alchemy_moonwort", 2, "alchemy_empty_bottle", 1);
+            AddRecipe("leather_waist_pouch", "other", 8, 1, "가죽 허리 파우치를 만듭니다.", "grip_leather", 3, "steel_fitting", 1);
+            AddRecipe("expedition_backpack", "other", 12, 1, "원정 배낭을 만듭니다.", "grip_leather", 4, "steel_fitting", 2);
+            AddRecipe("wooden_arrow", "other", 4, 5, "나무 화살 다섯 개를 조립합니다.", "steel_fitting", 1, "grip_leather", 1);
+            AddRecipe("linen_bandage", "other", 3, 2, "붕대 두 개를 준비합니다.", "grip_leather", 1, "alchemy_water", 1);
+            AddRecipe("field_torch", "other", 4, 1, "원정용 횃불을 만듭니다.", "forge_charcoal", 1, "grip_leather", 1, "lamp_oil", 1);
+        }
+
+        void AddRecipe(string output, string category, double seconds, int outputQuantity, string description, params object[] costs)
+        {
+            if (Inventory.Definition(output).Count == 0) throw new ArgumentException("Unknown crafting output: " + output);
+            var materials = new JObject();
+            for (int i = 0; i < costs.Length; i += 2)
+            {
+                string id = (string)costs[i]; int amount = (int)costs[i + 1];
+                if (Inventory.Definition(id).Count == 0 || amount <= 0) throw new ArgumentException("Invalid crafting ingredient: " + id);
+                materials[id] = amount;
+            }
+            recipes[output] = new JObject { ["id"] = output, ["name"] = Inventory.ItemName(output), ["description"] = description,
+                ["category"] = category, ["output_id"] = output, ["output_quantity"] = outputQuantity, ["seconds"] = seconds, ["materials"] = materials };
+        }
+
+        public JObject Recipe(string id) => id != null && recipes.TryGetValue(id, out var recipe) ? Clone(recipe) : new JObject();
+
+        public JArray MaterialRows(string recipeId, int quantity)
+        {
+            var result = new JArray();
+            if (!recipes.TryGetValue(recipeId ?? "", out var recipe) || quantity < 1 || quantity > MaximumQuantity) return result;
+            foreach (var cost in ((JObject)recipe["materials"]).Properties())
+            {
+                int required = (int)cost.Value * quantity, owned = Inventory.CountItem(cost.Name);
+                result.Add(new JObject { ["id"] = cost.Name, ["name"] = Inventory.ItemName(cost.Name), ["per_unit"] = (int)cost.Value,
+                    ["required"] = required, ["owned"] = owned, ["enough"] = owned >= required });
+            }
+            return result;
+        }
+
+        public int MaximumCraftable(string recipeId)
+        {
+            if (!recipes.TryGetValue(recipeId ?? "", out var recipe)) return 0;
+            int maximum = MaximumQuantity;
+            foreach (var cost in ((JObject)recipe["materials"]).Properties())
+                maximum = Math.Min(maximum, Inventory.CountItem(cost.Name) / (int)cost.Value);
+            return maximum;
+        }
+
+        public JObject Enqueue(string recipeId, int quantity = 1)
+        {
+            if (busy) return Result(false, "busy");
+            if (!recipes.TryGetValue(recipeId ?? "", out var recipe)) return Result(false, "invalid_recipe");
+            if (quantity < 1 || quantity > MaximumQuantity) return Result(false, "invalid_quantity");
+            if (jobs.Count >= MaximumQueueLength) return Result(false, "queue_full");
+            if (MaximumCraftable(recipeId) < quantity) return Result(false, "missing_materials");
+            busy = true;
+            try
+            {
+                // Reserve exact stacks so cancellation preserves tags and other instance data.
+                var reserved = new JArray();
+                foreach (var cost in ((JObject)recipe["materials"]).Properties())
+                {
+                    int remaining = (int)cost.Value * quantity;
+                    for (int i = Inventory.Slots.Count - 1; i >= 0 && remaining > 0; i--)
+                    {
+                        if ((string)Inventory.Slots[i]["id"] != cost.Name) continue;
+                        int moved = Math.Min(remaining, (int)Inventory.Slots[i]["quantity"]);
+                        reserved.Add(Inventory.RemoveFromSlot(i, moved, false)); remaining -= moved;
+                    }
+                }
+                string jobId = (nextJobId++).ToString(System.Globalization.CultureInfo.InvariantCulture);
+                double duration = (double)recipe["seconds"] * quantity;
+                jobs.Add(new JObject { ["id"] = jobId, ["recipe_id"] = recipeId, ["name"] = (string)recipe["name"], ["quantity"] = quantity,
+                    ["output_id"] = (string)recipe["output_id"], ["output_quantity"] = (int)recipe["output_quantity"] * quantity,
+                    ["remaining"] = duration, ["duration"] = duration, ["state"] = jobs.Count == 0 ? "crafting" : "queued", ["reserved"] = reserved });
+                Inventory.NotifyChanged(); Changed?.Invoke();
+                var result = Result(true); result["job_id"] = jobId; return result;
+            }
+            finally { busy = false; }
+        }
+
+        /// <summary>Cancel returns all reserved ingredients; a full bag keeps them safely in the queue.</summary>
+        public JObject Cancel(string jobId)
+        {
+            if (busy) return Result(false, "busy");
+            var job = jobs.FirstOrDefault(j => (string)j["id"] == jobId);
+            if (job == null) return Result(false, "missing_job");
+            busy = true;
+            try
+            {
+                job["state"] = "refund_pending";
+                bool refunded = TryAdd((JArray)job["reserved"]);
+                if (refunded) { jobs.Remove(job); PromoteFirst(); Inventory.NotifyChanged(); }
+                Changed?.Invoke(); var result = Result(true, refunded ? "" : "refund_pending"); result["refund_pending"] = !refunded; return result;
+            }
+            finally { busy = false; }
+        }
+
+        /// <summary>Only the first job consumes time. Completed output waits intact for bag room.</summary>
+        public void Tick(double delta)
+        {
+            if (busy || !Finite(delta) || delta < 0 || jobs.Count == 0) return;
+            busy = true;
+            bool queueChanged = false, bagChanged = false;
+            try
+            {
+                // A cancelled later job may be refunded without waiting for the active job.
+                foreach (var cancelled in jobs.Where(j => (string)j["state"] == "refund_pending").ToArray())
+                    if (TryAdd((JArray)cancelled["reserved"])) { jobs.Remove(cancelled); queueChanged = true; bagChanged = true; }
+                PromoteFirst();
+                while (jobs.Count > 0)
+                {
+                    var job = jobs[0];
+                    if ((string)job["state"] == "refund_pending") break;
+                    double remaining = (double)job["remaining"], used = Math.Min(remaining, delta);
+                    if (used > 0) { job["remaining"] = remaining - used; delta -= used; queueChanged = true; }
+                    if ((double)job["remaining"] > 0) break;
+                    if ((string)job["state"] != "waiting_output") { job["state"] = "waiting_output"; queueChanged = true; }
+                    var output = new JArray(new JObject { ["id"] = (string)job["output_id"], ["quantity"] = (int)job["output_quantity"] });
+                    if (!TryAdd(output)) break;
+                    // Remove before notifying subscribers to prevent completion reentry.
+                    jobs.RemoveAt(0); PromoteFirst(); queueChanged = true; bagChanged = true;
+                    if (delta <= 0) break;
+                }
+                if (bagChanged) Inventory.NotifyChanged();
+                if (queueChanged) Changed?.Invoke();
+            }
+            finally { busy = false; }
+        }
+
+        void PromoteFirst()
+        {
+            if (jobs.Count > 0 && (string)jobs[0]["state"] == "queued") jobs[0]["state"] = "crafting";
+        }
+
+        // Multiple output/refund stacks share the same capacity check and commit together.
+        bool TryAdd(JArray stacks)
+        {
+            var simulation = new ExpeditionInventory(catalog);
+            foreach (var stack in Inventory.Slots) simulation.Slots.Add(Clone(stack));
+            foreach (var stack in stacks.OfType<JObject>())
+                if (simulation.AddItem((string)stack["id"], (int)stack["quantity"], false, stack["instance"] as JObject) > 0) return false;
+            Inventory.Slots.Clear();
+            foreach (var stack in simulation.Slots) Inventory.Slots.Add(Clone(stack));
+            return true;
+        }
+
+        public JObject Snapshot() => new JObject { ["next_job_id"] = nextJobId, ["queue"] = Queue };
+
+        /// <summary>Restore an internally captured queue without replacing the expedition bag.</summary>
+        public bool Restore(JObject snapshot)
+        {
+            if (busy || snapshot == null || !(snapshot["queue"] is JArray queue) || queue.Count > MaximumQueueLength) return false;
+            long next;
+            var restored = new List<JObject>(); var seen = new HashSet<string>();
+            try
+            {
+                next = (long?)snapshot["next_job_id"] ?? 0;
+                if (next < 1 || next == long.MaxValue) return false;
+                foreach (var value in queue)
+                {
+                    if (!(value is JObject job) || !recipes.TryGetValue((string)job["recipe_id"] ?? "", out var recipe)) return false;
+                    string id = (string)job["id"], state = (string)job["state"];
+                    int quantity = (int?)job["quantity"] ?? 0;
+                    double duration = (double?)job["duration"] ?? -1, remaining = (double?)job["remaining"] ?? -1;
+                    if (!long.TryParse(id, out long numericId) || numericId < 1 || numericId >= next || !seen.Add(id)
+                        || quantity < 1 || quantity > MaximumQuantity || !Finite(duration) || !Finite(remaining)
+                        || duration != (double)recipe["seconds"] * quantity || remaining < 0 || remaining > duration
+                        || (state != "queued" && state != "crafting" && state != "waiting_output" && state != "refund_pending")
+                        || (state == "waiting_output" && remaining != 0) || !(job["reserved"] is JArray reserved)) return false;
+                    var totals = new Dictionary<string, int>();
+                    foreach (var token in reserved)
+                    {
+                        if (!(token is JObject stack)) return false;
+                        string ingredient = (string)stack["id"]; int amount = (int?)stack["quantity"] ?? 0;
+                        if (ingredient == null || amount <= 0 || recipe["materials"]?[ingredient] == null) return false;
+                        totals[ingredient] = checked((totals.TryGetValue(ingredient, out int current) ? current : 0) + amount);
+                    }
+                    foreach (var cost in ((JObject)recipe["materials"]).Properties())
+                        if (!totals.TryGetValue(cost.Name, out int amount) || amount != (int)cost.Value * quantity) return false;
+                    var copy = Clone(job);
+                    copy["name"] = (string)recipe["name"]; copy["output_id"] = (string)recipe["output_id"];
+                    copy["output_quantity"] = (int)recipe["output_quantity"] * quantity;
+                    restored.Add(copy);
+                }
+            }
+            catch (Exception error) when (error is FormatException || error is InvalidCastException || error is OverflowException || error is ArgumentException)
+            { return false; }
+            jobs.Clear(); jobs.AddRange(restored); nextJobId = next; PromoteFirst(); Changed?.Invoke(); return true;
+        }
+
+        /// <summary>A compact, catalog-backed supply set for isolated F2 trials.</summary>
+        public JObject TrialSupplies() => new JObject { ["iron_ingot"] = 8, ["forge_charcoal"] = 6, ["grip_leather"] = 8, ["steel_fitting"] = 6,
+            ["alchemy_water"] = 8, ["alchemy_spirits"] = 4, ["alchemy_redroot"] = 8, ["alchemy_dawnleaf"] = 4,
+            ["alchemy_bittermint"] = 8, ["alchemy_ironbloom"] = 4, ["alchemy_moonwort"] = 6, ["alchemy_empty_bottle"] = 8, ["lamp_oil"] = 3 };
+    }
+}
