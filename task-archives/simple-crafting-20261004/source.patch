+++ b/unity-game/Assets/RPG/Gameplay/NativeCrafting.cs
@@ -0,0 +1,221 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using Newtonsoft.Json.Linq;
+using UnityEngine;
+
+namespace MusimusihanRpg.Gameplay
+{
+    /// <summary>One recipe grid, materials table and FIFO queue shared by every crafting station.</summary>
+    public sealed class NativeCrafting
+    {
+        readonly WorkshopController game;
+        readonly NativeGameFlow flow;
+        readonly Dictionary<string, RectTransform> nodes = new Dictionary<string, RectTransform>();
+        readonly List<UnityEngine.UI.Button> recipeButtons = new List<UnityEngine.UI.Button>();
+        readonly List<string> recipeIds = new List<string>();
+        readonly Dictionary<string, UnityEngine.UI.Button> categories = new Dictionary<string, UnityEngine.UI.Button>();
+        readonly RectTransform root, grid, materials, queue;
+        readonly UnityEngine.UI.Text title, description, amount, duration, status;
+        readonly UnityEngine.UI.Button create, maximum, previous, next;
+        readonly UnityEngine.UI.RawImage preview;
+        string selected = "", queueKey = "", materialKey = "";
+        string savedCategory="all",savedSelected="";int savedQuantity=1,savedPage;
+        int quantity = 1, page;
+        readonly Color accent = new Color(.19f, .55f, .75f), ink = new Color(.91f, .91f, .87f);
+        public string Category { get; private set; } = "all";
+        public RectTransform Root => root;
+        public string SelectedRecipe => selected;
+        public int Quantity => quantity;
+        public bool IsOpen => flow.State == "crafting" && root.gameObject.activeInHierarchy;
+
+        public NativeCrafting(WorkshopController game, NativeGameFlow flow)
+        {
+            this.game = game; this.flow = flow;
+            root = Panel(flow.Ui.CanvasRoot, "SimpleCrafting", 48, 56, 1184, 608, new Color(.12f, .13f, .13f, .97f));
+            Label(root, "Heading", "제작", 24, 14, 700, 40, 26);
+            Button(root, "CloseCrafting", "닫기  [Esc]", 1032, 16, 132, 36, flow.CloseCrafting);
+            Panel(root, "Divider", 20, 63, 1144, 1, new Color(.38f, .39f, .37f));
+            Label(root, "CategoriesHeading", "분류", 20, 76, 136, 30, 16);
+            var tabs = new[] { ("all", "전체"), ("weapon", "무기"), ("armor", "방어구"), ("consumable", "물약"), ("other", "도구 · 소모품") };
+            for (int i = 0; i < tabs.Length; i++)
+            {
+                string id = tabs[i].Item1;
+                categories[id] = Button(root, "Category_" + id, tabs[i].Item2, 20, 114 + i * 44, 132, 38, () => SelectCategory(id));
+            }
+            Label(root, "RecipeHeading", "만들 아이템", 172, 76, 430, 30, 16);
+            grid = Panel(root, "Recipes", 172, 112, 456, 338, Color.clear, false);
+            for (int i = 0; i < 12; i++)
+            {
+                int index = i;
+                var b = Button(grid, "Recipe_" + i, "", i % 4 * 114, i / 4 * 110, 106, 102, () => { if (index < recipeIds.Count) SelectRecipe(recipeIds[index]); });
+                recipeButtons.Add(b);
+                b.GetComponentInChildren<UnityEngine.UI.Text>().gameObject.SetActive(false);
+                Art(b.transform, "Icon", 27, 4, 52, 52, "");
+                Label(b.transform, "Name", "", 4, 57, 98, 41, 13, TextAnchor.MiddleCenter);
+            }
+            previous = Button(root, "PreviousRecipes", "‹", 174, 448, 42, 26, () => { page--; BuildRecipes(); Refresh(); });
+            next = Button(root, "NextRecipes", "›", 586, 448, 42, 26, () => { page++; BuildRecipes(); Refresh(); });
+            Label(root, "RecipePage", "", 230, 448, 338, 26, 13, TextAnchor.MiddleCenter);
+            var details = Panel(root, "Details", 648, 76, 516, 398, new Color(.19f, .20f, .20f));
+            preview = Art(details, "Preview", 18, 16, 68, 68, "");
+            title = Label(details, "RecipeTitle", "", 104, 14, 388, 40, 22);
+            duration = Label(details, "Duration", "", 104, 57, 388, 26, 14);
+            description = Label(details, "Description", "", 20, 100, 476, 64, 16);
+            Label(details, "MaterialsHeading", "재료", 20, 172, 237, 28, 15);
+            Label(details, "MaterialsUnitHeading", "1회", 257, 172, 79, 28, 15, TextAnchor.MiddleRight);
+            Label(details, "MaterialsRequiredHeading", "필요", 336, 172, 79, 28, 15, TextAnchor.MiddleRight);
+            Label(details, "MaterialsOwnedHeading", "보유", 415, 172, 79, 28, 15, TextAnchor.MiddleRight);
+            materials = Panel(details, "Materials", 20, 206, 476, 104, Color.clear, false);
+            Button(details, "QuantityMinus", "−", 20, 324, 40, 42, () => SetQuantity(quantity - 1));
+            amount = Label(details, "Quantity", "1", 62, 324, 54, 42, 20, TextAnchor.MiddleCenter);
+            Button(details, "QuantityPlus", "+", 118, 324, 40, 42, () => SetQuantity(quantity + 1));
+            maximum = Button(details, "QuantityMax", "최대", 164, 324, 60, 42, () => SetQuantity(Math.Max(1, game.Crafting.MaximumCraftable(selected))));
+            create = Button(details, "CraftButton", "제작", 330, 324, 166, 42, () => Craft());
+            Label(details, "OutputCount", "", 20, 372, 476, 22, 13);
+            Panel(root, "QueueDivider", 20, 485, 1144, 1, new Color(.38f, .39f, .37f));
+            Label(root, "QueueHeading", "제작 대기열  /  CRAFTING QUEUE", 20, 494, 760, 27, 16);
+            queue = Panel(root, "Queue", 20, 527, 1144, 49, Color.clear, false);
+            status = Label(root, "CraftStatus", "재료를 확인하고 수량을 선택하세요.", 20, 581, 1144, 22, 13);
+            Hide();
+        }
+
+        public RectTransform Find(string name) => nodes.TryGetValue(name, out var n) ? n : null;
+        public void Open(string category = "all", bool restore = false)
+        {
+            root.gameObject.SetActive(true); root.SetAsLastSibling();
+            if (!restore) SelectCategory(category); else { Category=savedCategory;selected=savedSelected;quantity=savedQuantity;page=savedPage;BuildRecipes(); Refresh(); }
+        }
+        public void SavePresentation(){savedCategory=Category;savedSelected=selected;savedQuantity=quantity;savedPage=page;}
+        public void Hide() => root.gameObject.SetActive(false);
+        public void SelectCategory(string category)
+        {
+            if (!categories.ContainsKey(category)) category = "all";
+            Category = category; page = 0; selected = ""; quantity = 1;
+            BuildRecipes(); Refresh();
+        }
+        public void SelectRecipe(string id)
+        {
+            if (game.Crafting.Recipe(id).Count == 0) return;
+            selected = id; quantity = 1; Refresh();
+        }
+        public void SetQuantity(int value) { quantity = Mathf.Clamp(value, 1, 99); Refresh(); }
+        public JObject Craft()
+        {
+            if (!IsOpen) return new JObject { ["accepted"] = false, ["reason"] = "closed" };
+            var result = game.Crafting.Enqueue(selected, quantity); game.Reply(result);
+            status.text = (bool?)result["accepted"] == true ? "대기열에 추가했습니다. 완료하면 가방에 들어갑니다." : Failure((string)result["reason"]);
+            Refresh(); return result;
+        }
+        public JObject Cancel(string jobId)
+        {
+            if (!IsOpen) return new JObject { ["accepted"] = false, ["reason"] = "closed" };
+            var result = game.Crafting.Cancel(jobId);
+            status.text = (bool?)result["refund_pending"] == true ? "가방을 비우면 취소한 재료가 돌아옵니다." : (bool?)result["accepted"] == true ? "제작을 취소하고 재료를 돌려받았습니다." : Failure((string)result["reason"]);
+            Refresh(); return result;
+        }
+        static string Failure(string reason) => reason == "missing_materials" ? "재료가 부족합니다." : reason == "queue_full" ? "대기열이 가득 찼습니다." : reason == "refund_pending" ? "가방을 비우면 취소한 재료가 돌아옵니다." : "지금은 제작할 수 없습니다.";
+        void BuildRecipes()
+        {
+            var list = game.Crafting.Recipes.OfType<JObject>().Where(r => Category == "all" || (string)r["category"] == Category).ToArray();
+            int pages = Math.Max(1, (list.Length + 11) / 12); page = Mathf.Clamp(page, 0, pages - 1);
+            recipeIds.Clear(); recipeIds.AddRange(list.Skip(page * 12).Take(12).Select(r => (string)r["id"]));
+            if (!list.Any(r => (string)r["id"] == selected)) selected = recipeIds.FirstOrDefault() ?? "";
+            for (int i = 0; i < 12; i++)
+            {
+                var b = recipeButtons[i]; b.gameObject.SetActive(i < recipeIds.Count); if (i >= recipeIds.Count) continue;
+                var recipe = game.Crafting.Recipe(recipeIds[i]);
+                b.transform.Find("Name").GetComponent<UnityEngine.UI.Text>().text = (string)recipe["name"];
+                SetArt(b.transform.Find("Icon").GetComponent<UnityEngine.UI.RawImage>(), (string)recipe["output_id"]);
+            }
+            previous.interactable = page > 0; next.interactable = page + 1 < pages;
+            Find("RecipePage").GetComponent<UnityEngine.UI.Text>().text = $"{page + 1} / {pages}   ·   {list.Length}개 제조법";
+        }
+        public void Refresh()
+        {
+            if (game.Crafting == null) return;
+            foreach (var p in categories) p.Value.targetGraphic.color = p.Key == Category ? accent : new Color(.24f, .25f, .25f);
+            for (int i = 0; i < recipeIds.Count; i++) recipeButtons[i].targetGraphic.color = recipeIds[i] == selected ? new Color(.22f, .40f, .46f) : new Color(.25f, .27f, .27f);
+            var recipe = game.Crafting.Recipe(selected);
+            if (recipe.Count == 0) { create.interactable = false; return; }
+            title.text = (string)recipe["name"]; description.text = (string)recipe["description"];
+            duration.text = $"제작 시간  {(double)recipe["seconds"] * quantity:0.#}초";
+            amount.text = quantity.ToString(); SetArt(preview, (string)recipe["output_id"]);
+            Find("OutputCount").GetComponent<UnityEngine.UI.Text>().text = $"완성 수량  {(int)recipe["output_quantity"] * quantity}개  ·  제작 중 닫아도 대기열 유지";
+            int max = game.Crafting.MaximumCraftable(selected); maximum.interactable = max > 0;
+            create.interactable = max >= quantity && game.Crafting.Queue.Count < SimpleCraftingSystem.MaxQueue;
+            create.targetGraphic.color = create.interactable ? accent : new Color(.28f, .30f, .30f);
+            var rows=game.Crafting.MaterialRows(selected,quantity);
+            string currentMaterials=selected+"/"+quantity+"/"+rows.ToString(Newtonsoft.Json.Formatting.None);
+            if(materialKey!=currentMaterials)
+            {
+                materialKey=currentMaterials;Clear(materials);int index=0;
+                foreach(var row in rows.OfType<JObject>())
+                {
+                    string id=(string)row["id"];int y=index++*25;
+                    var c=(bool)row["enough"]?ink:new Color(1,.53f,.42f);
+                    Label(materials,"MaterialName_"+id,game.Session.Inventory.ItemName(id),0,y,237,24,14).color=c;
+                    Label(materials,"MaterialUnit_"+id,row["per_unit"].ToString(),237,y,79,24,14,TextAnchor.MiddleRight).color=c;
+                    Label(materials,"MaterialCount_"+id,row["required"].ToString(),316,y,79,24,14,TextAnchor.MiddleRight).color=c;
+                    Label(materials,"MaterialOwned_"+id,row["owned"].ToString(),395,y,79,24,14,TextAnchor.MiddleRight).color=c;
+                }
+            }
+            RefreshQueue();
+        }
+        void RefreshQueue()
+        {
+            var jobs = game.Crafting.Queue.OfType<JObject>().ToArray();
+            string key = string.Join("|", jobs.Select(j => (string)j["id"]));
+            if (key != queueKey || queue.childCount == 0)
+            {
+                queueKey = key; Clear(queue);
+                if (jobs.Length == 0) Label(queue, "EmptyQueue", "대기 중인 제작이 없습니다.", 0, 0, 1100, 49, 15);
+                for (int i = 0; i < jobs.Length; i++)
+                {
+                    string id = (string)jobs[i]["id"];
+                    var card = Panel(queue, "Job_" + id, i * 142, 0, 136, 49, new Color(.23f, .25f, .25f));
+                    Label(card, "JobText", "", 6, 1, 104, 46, 12);
+                    Button(card, "Cancel_" + id, "×", 108, 4, 24, 40, () => Cancel(id));
+                }
+            }
+            foreach (var job in jobs)
+            {
+                string state = (string)job["state"];
+                string line = state == "waiting_output" ? "가방 공간 대기" : state == "refund_pending" ? "재료 반환 대기" : state == "queued" ? "대기 중" : $"{(double)job["remaining"]:0.0}초";
+                var recipe = game.Crafting.Recipe((string)job["recipe_id"]);
+                queue.Find("Job_" + (string)job["id"]).Find("JobText").GetComponent<UnityEngine.UI.Text>().text = $"{recipe["name"]} ×{job["quantity"]}\n{line}";
+            }
+        }
+        void Clear(RectTransform parent)
+        {
+            for (int i = parent.childCount - 1; i >= 0; i--) { var child = parent.GetChild(i); child.gameObject.SetActive(false); UnityEngine.Object.Destroy(child.gameObject); }
+        }
+        RectTransform Rect(Transform parent, string name, float x, float y, float w, float h)
+        {
+            var go = new GameObject(name, typeof(RectTransform)); go.layer = 5; go.transform.SetParent(parent, false);
+            var r = (RectTransform)go.transform; r.anchorMin = r.anchorMax = r.pivot = new Vector2(0, 1); r.anchoredPosition = new Vector2(x, -y); r.sizeDelta = new Vector2(w, h); nodes[name] = r; return r;
+        }
+        RectTransform Panel(Transform parent, string name, float x, float y, float w, float h, Color color, bool hit = true)
+        {
+            var r = Rect(parent, name, x, y, w, h); var image = r.gameObject.AddComponent<UnityEngine.UI.Image>(); image.color = color; image.raycastTarget = hit; return r;
+        }
+        UnityEngine.UI.Text Label(Transform parent, string name, string text, float x, float y, float w, float h, int size, TextAnchor align = TextAnchor.MiddleLeft)
+        {
+            var r = Rect(parent, name, x, y, w, h); var t = r.gameObject.AddComponent<UnityEngine.UI.Text>(); t.font = game.KoreanFont != null ? game.KoreanFont : Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf"); t.text = text; t.fontSize = size; t.color = ink; t.alignment = align; t.raycastTarget = false; t.horizontalOverflow = HorizontalWrapMode.Wrap; return t;
+        }
+        UnityEngine.UI.Button Button(Transform parent, string name, string text, float x, float y, float w, float h, Action action)
+        {
+            var r = Panel(parent, name, x, y, w, h, new Color(.24f, .25f, .25f));
+            var b = r.gameObject.AddComponent<UnityEngine.UI.Button>(); b.targetGraphic = r.GetComponent<UnityEngine.UI.Image>(); b.onClick.AddListener(() => { if (IsOpen) action(); });
+            Label(r, name + "Label", text, 2, 0, w - 4, h, 15, TextAnchor.MiddleCenter); return b;
+        }
+        UnityEngine.UI.RawImage Art(Transform parent, string name, float x, float y, float w, float h, string id)
+        {
+            var r = Rect(parent, name, x, y, w, h); var image = r.gameObject.AddComponent<UnityEngine.UI.RawImage>(); image.raycastTarget = false; SetArt(image, id); return image;
+        }
+        void SetArt(UnityEngine.UI.RawImage art, string id)
+        {
+            var icon = game.ItemIcons.FirstOrDefault(i => i.Id == id); art.texture = icon?.Texture; art.uvRect = icon?.Uv ?? new Rect(0, 0, 1, 1); art.enabled = art.texture != null;
+        }
+    }
+}
