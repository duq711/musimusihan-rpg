@@ -0,0 +1,37 @@
+namespace MusimusihanRpg.Gameplay
+{
+    public sealed partial class NativeGameFlow
+    {
+        public NativeCrafting Crafting {get;private set;}
+
+        public void OpenCrafting(string category="all",bool restore=false)
+        {
+            if(Crafting==null||IsTransitioning||(!restore&&State!="playing"))return;
+            if(!restore)motor.PrepareForInventory();
+            else{game.Interaction?.Cancel();game.Combat?.Cancel();game.Items.Cancel();}
+            motor.GetComponent<PlayerPresentation>()?.Torch?.CancelIgnition();
+            motor.ReleasePointer();motor.Paused=true;State="crafting";
+            Ui.Visible("hideout",false);Ui.Visible("title",false);Ui.Visible("merchant",false);
+            Crafting.Open(category,restore);
+        }
+
+        public void CloseCrafting()
+        {
+            if(State!="crafting")return;
+            Crafting.Hide();State="playing";Ui.Visible("hideout",true);
+            motor.Paused=game.SimulationPaused;motor.CapturePointer();
+        }
+
+        public static bool IsCraftingTrial(string id)=>id=="simple_crafting";
+
+        public void BeginNativeCraftingTrial(string category="all")
+        {
+            SaveNativeTrialPresentation();NativeTrial=true;returningFromTrials=false;
+            motor=game.DungeonPlayer;InHideout=true;State="playing";motor.NativeHud=true;
+            motor.Paused=true;motor.Eyes.enabled=false;
+            BindHideoutInteractions(game.DungeonRoot);BindHideoutLighting(game.DungeonRoot);
+            game.Combat.SafeZone=true;RestoreWorldPresentation();
+            Ui.gameObject.SetActive(true);OpenCrafting(category);
+        }
+    }
+}
