+        string Output => Environment.GetEnvironmentVariable("RPG_SIMPLE_CRAFTING_OUTPUT") ?? Path.Combine(Application.persistentDataPath, "simple-crafting-acceptance.json");
+        void Capture()
+        {
+            if (!Environment.GetCommandLineArgs().Contains("-simpleCraftingCapture")) return;
+            Check(SystemInfo.graphicsDeviceType == GraphicsDeviceType.Metal, "Requested screen capture uses the actual Metal renderer");
+            var ui = flow.Ui;
+            Check(ui.Renderer != null && ui.Renderer.Ready, "Production UI renderer is ready for an offscreen screen capture");
+            var target = new RenderTexture(1280, 720, 24, RenderTextureFormat.ARGB32);
+            var active = RenderTexture.active;
+            var scalers=ui.GetComponentsInChildren<CanvasScaler>();
+            var scalerEnabled=scalers.Select(s=>s.enabled).ToArray();
+            var canvasScales=scalers.Select(s=>s.GetComponent<Canvas>().scaleFactor).ToArray();
+            target.Create();
+            Texture2D pixels = null;
+            try
+            {
+                foreach(var scaler in scalers){scaler.enabled=false;scaler.GetComponent<Canvas>().scaleFactor=1;}
+                foreach(var graphic in ui.GetComponentsInChildren<Graphic>())graphic.SetAllDirty();
+                Canvas.ForceUpdateCanvases();
+                ui.Renderer.RenderTo(target, Array.Empty<SourceSceneRenderer>());
+                RenderTexture.active = target;
+                pixels = new Texture2D(1280, 720, TextureFormat.RGBA32, false, true);
+                pixels.ReadPixels(new Rect(0, 0, 1280, 720), 0, 0); pixels.Apply();
+                string path = Path.Combine(Path.GetDirectoryName(Path.GetFullPath(Output)), "simple-crafting.png");
+                Directory.CreateDirectory(Path.GetDirectoryName(path));
